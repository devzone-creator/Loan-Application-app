<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="form.css">
    <link rel="stylesheet" href="header.css">
</head>
<body>

    <%- include('./partials/nav.ejs') %>

    <main>
        <div class="container">
            <h1>Loan Application Form</h1>
            <form id="loanform">
                <h1>LOAN APPLICATION FORM</h1>
                <div class="form-section">
                    <h2>Personal Details</h2>
                    <div class="forms">
                        <div class="form-group">
                            <label for="fullname">Full Name *</label>
                            <input type="text" id="fullName" required>
                        </div>
                        <div class="form-group">
                            <label for="email">Email *</label>
                            <input type="text" id="email" required>
                        </div>
                        <div class="form-group">
                            <label for="phoneNumber">Phone Number *</label>
                            <input type="tel" id="pNumber" required>
                        </div>
                        <div class="form-group">
                            <label for="address">Residential Address *</label>
                            <input type="text" id="address">
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h2>Loan Details</h2>
                    <div class="forms">
                        <div class="form-group">
                            <label for="loanAmount">Loan Amount *</label>
                            <input type="number" id="loanAmount">
                        </div>
                        <div class="form-group">
                            <label for="loanTerm">Loan Term (months/Years) *</label>
                            <input type="number" id="loanTerm">
                        </div>
                        <div class="form-group">
                            <label for="purpose">Purpose of Loan *</label>
                            <textarea id="loanPurpose"></textarea>
                        </div>
                    </div>
                </div>


                <div class="form-section">
                    <h2>Financial Information</h2>
                    <div class="forms">
                        <div class="form-group">
                            <label for="income">Income *</label>
                            <input type="number" id="income">
                        </div>
                        <div class="form-group">
                            <label for="employement">Employement Status *</label>
                            <select id="employementStatus" required>
                                <option value="employed">Employed</option>
                                <option value="unemployed">Unemployed</option>
                                <option value="selfEmployed">Self Employed</option>
                                <option value="student">Student</option>
                                <option value="retired">Retired</option>
                            </select>
                        </div><br>
                        <div class="form-group">
                            <label for="other">Other Sources of Income </label>
                            <input type="text" id="others">
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h2>Additional Information</h2>
                    <div class="forms">
                        <div class="form-group">
                            <label for="">Any Outstanding loans or Debts ?</label>
                            <input type="text">
                        </div>
                        <div class="form-group">
                            <label for="">If yes, please provide details </label>
                            <input type="text" id="">
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <p>I [<input type="text" id="">], hereby declare that the information provided is true and accurate.
                        I understand that providing false Information
                        may result in my loan application being rejected or my loan being terminated. 
                    </p>
                    <input type="checkbox" id="">
                    <input type="date" id="">
                </div>

                <div class="form-btn">
                    <button type="submit">Submit Form</button>
                </div>

            </form>
        </div>
    </main>

    <script src="script.js"></script>
</body>
</html>